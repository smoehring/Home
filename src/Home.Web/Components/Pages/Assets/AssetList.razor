@page "/assets"
@inject AssetService AssetSvc
@rendermode InteractiveServer

<PageTitle>Assets</PageTitle>
<h1>Assets</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control w-auto" placeholder="Search name, brand, serial" @bind="_search" @bind:event="oninput" @onkeyup="OnKey" />
    <button class="btn btn-secondary" @onclick="Reload">Search</button>
    <a class="btn btn-primary" href="assets/new">New asset</a>
</div>

@if (_result is null) { <p>Loading…</p> }
else
{
    <table class="table table-sm">
        <thead><tr><th>Name</th><th>Brand</th><th>Type</th><th>Serial</th><th>State</th></tr></thead>
        <tbody>
        @foreach (var a in _result.Items)
        {
            <tr><td><a href="assets/@a.Uuid">@a.Name</a></td><td>@a.Brand</td><td>@a.Type</td><td>@a.SerialNumber</td><td>@a.State</td></tr>
        }
        </tbody>
    </table>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-outline-secondary" disabled="@(_page <= 1)" @onclick="Prev">Previous</button>
        <span>Page @_page of @Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)_result.PageSize)) (@_result.TotalCount)</span>
        <button class="btn btn-outline-secondary" disabled="@(_page * _result.PageSize >= _result.TotalCount)" @onclick="Next">Next</button>
    </div>
}

@code {
    private string? _search;
    private int _page = 1;
    private PagedResult<AssetListItem>? _result;

    protected override Task OnInitializedAsync() => Load();
    private Task Load() => Task.Run(async () => _result = await AssetSvc.SearchAsync(new AssetQuery(_search, _page)));
    private async Task Reload() { _page = 1; await Load(); }
    private async Task Prev() { _page--; await Load(); }
    private async Task Next() { _page++; await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Reload(); }
}
